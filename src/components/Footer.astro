---
import { site } from '~/data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();

interface Props { noMargin?: boolean }
const { noMargin = false } = Astro.props;
---

<footer class="site-footer" style={noMargin ? 'margin-top: 0' : ''}>
  <div class="site-footer-inner">
    <div>
      <h4>{site.authorName}</h4>
      <p style="color: var(--ink-mute); margin-top: 0.25rem;">{site.location}</p>
    </div>
    <div class="footer-links">
      <a href={`${base}/galerie`} class="link-underline">Galerie</a>
      <a href={`${base}/o-mne`} class="link-underline">O mně</a>
      <a href={`${base}/kontakt`} class="link-underline">Kontakt</a>
    </div>
  </div>
  <div style="max-width: var(--container); margin: 3rem auto 0; padding-top: 1.5rem; border-top: 1px solid var(--line); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; font-size: 0.8125rem;">
    <span>© {year} {site.authorName}. Všechna práva vyhrazena.</span>
    <span>Postaveno s Astro a péčí.</span>
  </div>
</footer>
