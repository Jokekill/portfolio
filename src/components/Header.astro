---
import { site } from '~/data/site';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isActive = (href: string) => {
  const full = `${base}${href}`;
  if (href === '/') return path === '/' || path === `${base}/` || path === base;
  return path.startsWith(full);
};

const links = [
  { href: '/', label: 'Domů' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/o-mne', label: 'O mně' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<header class="site-header">
  <a href={`${base}/`} class="site-logo" aria-label="Domů">
    {site.authorName}
  </a>

  <nav class="site-nav site-nav-desktop" aria-label="Hlavní menu">
    {links.map((link) => (
      <a href={`${base}${link.href}`} class={isActive(link.href) ? 'active' : ''}>
        {link.label}
      </a>
    ))}
  </nav>

  <button
    class="menu-toggle"
    aria-label="Otevřít menu"
    aria-controls="mobileNav"
    aria-expanded="false"
    id="menuToggle"
    type="button"
  >
    <span></span>
    <span></span>
  </button>
</header>

<nav
  class="site-nav site-nav-mobile"
  id="mobileNav"
  aria-label="Mobilní menu"
  aria-hidden="true"
>
  {links.map((link, i) => (
    <a href={`${base}${link.href}`} class={isActive(link.href) ? 'active' : ''}>
      <span class="nav-num">0{i + 1}</span>
      {link.label}
    </a>
  ))}
</nav>

<script>
  // Delegované listenery na document — přežijí view-transition
  // výměnu DOM a modul se váže jen jednou za session.
  const setOpen = (open: boolean) => {
    const toggle = document.getElementById('menuToggle');
    const nav = document.getElementById('mobileNav');
    if (!toggle || !nav) return;
    toggle.classList.toggle('open', open);
    nav.classList.toggle('open', open);
    document.body.classList.toggle('nav-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    nav.setAttribute('aria-hidden', String(!open));
    toggle.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
  };

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const toggle = target.closest('#menuToggle');
    if (toggle) {
      setOpen(!toggle.classList.contains('open'));
      return;
    }
    if (target.closest('#mobileNav a')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && document.getElementById('menuToggle')?.classList.contains('open')) {
      setOpen(false);
    }
  });

  // Po resize nad mobilní breakpoint menu vždy zavři, aby se nezaseklo
  const mq = window.matchMedia('(min-width: 721px)');
  mq.addEventListener?.('change', (e) => {
    if (e.matches) setOpen(false);
  });

  // Po navigaci mezi stránkami začni se zavřeným menu
  document.addEventListener('astro:after-swap', () => setOpen(false));
</script>
