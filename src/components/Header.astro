---
import { site } from '~/data/site';

const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isActive = (href: string) => {
  const full = `${base}${href}`;
  if (href === '/') return path === '/' || path === `${base}/` || path === base;
  return path.startsWith(full);
};

const links = [
  { href: '/', label: 'Domů' },
  { href: '/galerie', label: 'Galerie' },
  { href: '/o-mne', label: 'O mně' },
  { href: '/kontakt', label: 'Kontakt' },
];
---

<header class="site-header">
  <a href={`${base}/`} class="site-logo" aria-label="Domů">
    {site.authorName}
  </a>

  <button class="menu-toggle" aria-label="Menu" id="menuToggle">
    <span></span>
    <span></span>
  </button>

  <nav class="site-nav" id="siteNav">
    {links.map((link) => (
      <a href={`${base}${link.href}`} class={isActive(link.href) ? 'active' : ''}>
        {link.label}
      </a>
    ))}
  </nav>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const nav = document.getElementById('siteNav');
  toggle?.addEventListener('click', () => {
    toggle.classList.toggle('open');
    nav?.classList.toggle('open');
  });
  // Zavři menu po kliknutí na link
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.classList.remove('open');
      nav.classList.remove('open');
    })
  );
</script>
