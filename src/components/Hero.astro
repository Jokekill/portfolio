---
import photosData from '~/data/photos.json';
import { site } from '~/data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Vyber featured fotku s největším poměrem na šířku (pro hero pozadí)
const featured = photosData
  .filter((p) => p.featured)
  .sort((a, b) => b.width / b.height - a.width / a.height)[0] || photosData[0];

const heroSrc = `${base}/images/generated/${featured.src}-2400.jpg`;
const heroSrcSmall = `${base}/images/generated/${featured.src}-1600.jpg`;

const [firstName, ...restName] = site.authorName.split(' ');
const photoCount = photosData.length;
---

<section class="hero">
  <div class="hero-bg">
    <picture>
      <source
        type="image/webp"
        srcset={`${base}/images/generated/${featured.src}-1600.webp 1600w, ${base}/images/generated/${featured.src}-2400.webp 2400w`}
        sizes="100vw"
      />
      <img
        src={heroSrc}
        srcset={`${heroSrcSmall} 1600w, ${heroSrc} 2400w`}
        sizes="100vw"
        alt={featured.alt}
        loading="eager"
        fetchpriority="high"
      />
    </picture>
    <div class="hero-vignette"></div>
  </div>

  <div class="hero-content">
    <span class="eyebrow reveal" style="animation-delay: 0.1s">{site.tagline}</span>
    <h1 class="hero-title">
      <span class="hero-line reveal" style="animation-delay: 0.25s">{firstName}</span>
      <span class="hero-line hero-line-italic reveal" style="animation-delay: 0.35s">{restName.join(' ')}</span>
    </h1>
    <p class="hero-intro reveal" style="animation-delay: 0.55s">{site.intro}</p>
    <div class="hero-cta reveal" style="animation-delay: 0.7s">
      <a href={`${base}/galerie`} class="btn btn-primary">Prohlédnout galerii</a>
      <a href={`${base}/kontakt`} class="btn btn-ghost">Domluvit focení</a>
    </div>
  </div>

  <div class="hero-foot reveal" style="animation-delay: 1.1s">
    <span class="hero-foot-item">{photoCount} fotografií</span>
    <span class="hero-foot-item">{site.location}</span>
    <span class="hero-foot-item hero-scroll-hint">
      Scroll
      <span class="hero-scroll-line"></span>
    </span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    padding: 0 var(--gutter) 3.5rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.06);
    animation: heroZoom 16s var(--ease) forwards;
  }

  @keyframes heroZoom {
    to { transform: scale(1); }
  }

  .hero-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--bg) 0%, transparent 40%, transparent 70%, rgba(10, 9, 8, 0.4) 100%),
      linear-gradient(to right, rgba(10, 9, 8, 0.45) 0%, transparent 55%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--container);
    width: 100%;
    margin: 0 auto;
  }

  .hero-title {
    margin: 1rem 0 1.5rem;
    font-size: clamp(3.5rem, 16vw, 10rem);
    line-height: 0.92;
    letter-spacing: -0.02em;
  }

  .hero-line {
    display: block;
  }

  .hero-line-italic {
    margin-left: clamp(1.5rem, 8vw, 6rem);
    font-style: italic;
    color: var(--ink-soft);
  }

  .hero-intro {
    max-width: 32rem;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }

  .hero-cta .btn {
    justify-content: center;
  }

  /* Spodní meta lišta — na mobilu skrytá */
  .hero-foot {
    display: none;
  }

  @media (min-width: 480px) {
    .hero-cta {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 721px) {
    .hero {
      padding-bottom: 6rem;
    }

    .hero-title {
      margin: 1.5rem 0 2rem;
    }

    .hero-intro {
      font-size: 1.0625rem;
      margin-bottom: 2.5rem;
    }

    .hero-cta {
      gap: 1rem;
    }

    .hero-foot {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 2rem;
      padding: 1.25rem var(--gutter);
      border-top: 1px solid var(--line);
      font-size: 0.6875rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--ink-mute);
    }

    .hero-foot-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .hero-scroll-line {
      width: 48px;
      height: 1px;
      background: linear-gradient(to right, var(--ink-mute), transparent);
      animation: scrollPulse 2.4s ease-in-out infinite;
    }
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
</style>
