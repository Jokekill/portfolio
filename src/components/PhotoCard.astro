---
interface Props {
  photo: {
    id: string;
    title: string;
    description?: string;
    category: string;
    src: string;
    alt: string;
    width: number;
    height: number;
  };
  index: number;
}

const { photo, index } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const gen = `${base}/images/generated`;
---

<a
  href="#"
  class="photo-card"
  data-photo-id={photo.id}
  data-photo-category={photo.category}
  data-photo-index={index}
  style={`--aspect: ${photo.width} / ${photo.height};`}
  aria-label={`Otevřít fotografii: ${photo.title}`}
>
  <picture>
    <source
      type="image/webp"
      srcset={`${gen}/${photo.src}-480.webp 480w, ${gen}/${photo.src}-960.webp 960w, ${gen}/${photo.src}-1600.webp 1600w`}
      sizes="(max-width: 720px) 100vw, (max-width: 1200px) 50vw, 33vw"
    />
    <img
      src={`${gen}/${photo.src}-960.jpg`}
      srcset={`${gen}/${photo.src}-480.jpg 480w, ${gen}/${photo.src}-960.jpg 960w, ${gen}/${photo.src}-1600.jpg 1600w`}
      sizes="(max-width: 720px) 100vw, (max-width: 1200px) 50vw, 33vw"
      alt={photo.alt}
      loading="lazy"
      decoding="async"
      width={photo.width}
      height={photo.height}
    />
  </picture>

  <div class="photo-card-meta">
    <h3>{photo.title}</h3>
    {photo.description && <span>{photo.description}</span>}
  </div>
</a>

<style>
  .photo-card {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--bg-elevated);
    aspect-ratio: var(--aspect);
    cursor: pointer;
    isolation: isolate;
  }

  .photo-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease), filter var(--transition);
    filter: brightness(0.92) saturate(0.95);
  }

  .photo-card:hover img {
    transform: scale(1.04);
    filter: brightness(1) saturate(1);
  }

  .photo-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 12, 10, 0.85) 0%, transparent 50%);
    opacity: 0;
    transition: opacity var(--transition);
    z-index: 1;
  }

  .photo-card:hover::before {
    opacity: 1;
  }

  .photo-card-meta {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 2;
    transform: translateY(8px);
    opacity: 0;
    transition: all var(--transition);
  }

  .photo-card:hover .photo-card-meta {
    transform: translateY(0);
    opacity: 1;
  }

  .photo-card-meta h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    font-style: italic;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  .photo-card-meta span {
    font-size: 0.8125rem;
    color: var(--ink-soft);
    display: block;
  }

  /* Na dotykových zařízeních — meta vždy vidět tlumeně */
  @media (hover: none) {
    .photo-card::before { opacity: 0.7; }
    .photo-card-meta { transform: none; opacity: 1; }
  }
</style>
