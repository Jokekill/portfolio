---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/data/site';

const mailto = `mailto:${site.email}?subject=${encodeURIComponent('Poptávka focení')}`;
---

<BaseLayout title="Kontakt" description={`Kontakt na fotografa ${site.authorName}.`}>
  <section class="contact">
    <div class="contact-inner">
      <span class="eyebrow">Ozvěte se mi</span>
      <h1>Domluvme <em>focení</em>.</h1>
      <p class="contact-lead">
        Píšu zpět obvykle do 24 hodin. Pokud spěcháte, napište do předmětu
        „naléhavé" — uvidím to dřív.
      </p>

      <div class="contact-grid">
        <a href={mailto} class="contact-card" data-reveal>
          <span class="contact-card-label">E-mail</span>
          <span class="contact-card-value contact-card-value-long">{site.email}</span>
          <span class="contact-card-cta">Napsat →</span>
        </a>

        <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="contact-card" data-reveal style="--reveal-delay: 100ms">
          <span class="contact-card-label">Instagram</span>
          <span class="contact-card-value">@{site.instagram}</span>
          <span class="contact-card-cta">Otevřít profil →</span>
        </a>

        <div class="contact-card contact-card-static" data-reveal style="--reveal-delay: 200ms">
          <span class="contact-card-label">Kde mě najdete</span>
          <span class="contact-card-value">{site.location}</span>
          <span class="contact-card-cta">Pohybuju se po celé ČR</span>
        </div>
      </div>

      <div class="contact-types" data-reveal>
        <h3>S čím vám můžu pomoct</h3>
        <ul>
          <li>Cokoli co potřebujete nafotit :)</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding: 8rem var(--gutter) 4rem;
  }

  .contact-inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .contact h1 {
    margin: 1rem 0 1.75rem;
  }

  .contact-lead {
    font-size: 1.0625rem;
    max-width: 36rem;
    margin-bottom: 3rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: 5rem;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.75rem;
    background: var(--bg-elevated);
    border: 1px solid var(--line);
    min-height: 180px;
    transition: all var(--transition);
  }

  .contact-card:not(.contact-card-static):hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  .contact-card-label {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  .contact-card-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.1;
    color: var(--ink);
    overflow-wrap: anywhere;
  }

  /* Dlouhé hodnoty (e-mail) — menší písmo, ať se nelámou uprostřed slova */
  .contact-card-value-long {
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
  }

  .contact-card-cta {
    font-size: 0.875rem;
    color: var(--ink-soft);
  }

  .contact-types {
    padding-top: 3.5rem;
    border-top: 1px solid var(--line);
  }

  .contact-types h3 {
    margin-bottom: 1.5rem;
    color: var(--ink-soft);
    font-size: 0.8125rem;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .contact-types ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem 2rem;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-style: italic;
  }

  .contact-types li {
    padding: 0.5rem 0;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 801px) {
    .contact {
      padding: 10rem var(--gutter) 6rem;
    }

    .contact-lead {
      font-size: 1.125rem;
      margin-bottom: 4rem;
    }

    .contact-grid {
      grid-template-columns: repeat(3, 1fr);
      margin-bottom: 6rem;
    }

    .contact-card {
      padding: 2rem;
      min-height: 220px;
    }
  }
</style>
