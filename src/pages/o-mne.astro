---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { site } from '~/data/site';
import photosData from '~/data/photos.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const portrait = photosData.find((p) => p.category === 'portrety') || photosData[0];
---

<BaseLayout title="O mně" description={`O fotografovi ${site.authorName}.`}>
  <section class="about">
    <div class="about-grid">
      <div class="about-image">
        <picture>
          <source
            type="image/webp"
            srcset={`${base}/images/generated/${portrait.src}-960.webp 960w, ${base}/images/generated/${portrait.src}-1600.webp 1600w`}
            sizes="(max-width: 800px) 100vw, 40vw"
          />
          <img
            src={`${base}/images/generated/${portrait.src}-960.jpg`}
            srcset={`${base}/images/generated/${portrait.src}-960.jpg 960w, ${base}/images/generated/${portrait.src}-1600.jpg 1600w`}
            sizes="(max-width: 800px) 100vw, 40vw"
            alt={`Autoportrét — ${site.authorName}`}
            loading="eager"
          />
        </picture>
      </div>

      <div class="about-text">
        <span class="eyebrow">{site.location}</span>
        <h1>Ahoj, jsem {site.authorName.split(' ')[0]}.</h1>

        <p>
          Fotím (s přestávkami) od dětství. Začínal jsem, když mi rodiče dali do ruky foťák na film.
          Následně mě nadchli pro focení prarodiče, kteří pořádali fotosouteže pro svá vnoučata.
          Nyní fotím již hlavně pro sebe, tedy pro Radost.
        </p>

        <p>
          Nejvíc mě baví okamžiky, které se neopakují — ranní mlha, rozbřesk či mávnutí křídel ptáčka.
          Pracuju s přirozeným světlem, minimem rekvizit
          a v post-produkci se snažím zachovat, jak vše skutečně vypadalo.
        </p>

        <p>
          Pokud byste rádi spolupracovali — ozvěte se. Rád si rozšířím portfolio.
        </p>

        <div class="about-links">
          <a href={`mailto:${site.email}`} class="btn btn-primary">{site.email}</a>
          <a href={site.instagramUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
            @{site.instagram}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding: 10rem var(--gutter) 6rem;
  }

  .about-grid {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 5rem;
    align-items: start;
  }

  .about-image {
    position: sticky;
    top: 6rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--bg-elevated);
  }

  .about-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.95);
  }

  .about-text h1 {
    margin: 1rem 0 2.5rem;
  }

  .about-text h1 em {
    font-style: italic;
    color: var(--ink-soft);
  }

  .about-text p {
    margin-bottom: 1.5rem;
    color: var(--ink-soft);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .about-links {
    display: flex;
    gap: 1rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .about-grid { grid-template-columns: 1fr; gap: 3rem; }
    .about-image { position: static; aspect-ratio: 4 / 5; }
  }
</style>
