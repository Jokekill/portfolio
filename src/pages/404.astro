---
import BaseLayout from '~/layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Stránka nenalezena" noFooterMargin={true}>
  <section class="not-found">
    <div class="not-found-inner">
      <span class="eyebrow reveal" style="animation-delay: 0.1s">Chyba 404</span>
      <h1 class="reveal" style="animation-delay: 0.25s">
        Tahle stránka se <em>ztratila v mlze</em>.
      </h1>
      <p class="reveal" style="animation-delay: 0.45s">
        Buď už neexistuje, nebo jste zadali špatnou adresu.
        Zkuste to znovu z domovské stránky, nebo se rovnou podívejte na fotky.
      </p>
      <div class="not-found-cta reveal" style="animation-delay: 0.6s">
        <a href={`${base}/`} class="btn btn-primary">Zpět domů</a>
        <a href={`${base}/galerie`} class="btn btn-ghost">Otevřít galerii</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 6rem var(--gutter) 4rem;
  }

  .not-found-inner {
    max-width: var(--container);
    margin: 0 auto;
    width: 100%;
  }

  .not-found h1 {
    max-width: 14ch;
    margin: 1rem 0 1.5rem;
  }

  .not-found p {
    margin-bottom: 2.5rem;
  }

  .not-found-cta {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
  }

  .not-found-cta .btn {
    justify-content: center;
  }

  @media (min-width: 480px) {
    .not-found-cta {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
