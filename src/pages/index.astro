---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/Hero.astro';
import Gallery from '~/components/Gallery.astro';
import Lightbox from '~/components/Lightbox.astro';
import { site } from '~/data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout>
  <Hero />

  <section class="featured-section">
    <header class="section-header">
      <span class="eyebrow">Výběr</span>
      <h2>Nejnovější práce</h2>
      <p>
        Krátký výběr z poslední doby. Kompletní portfolio najdete v
        <a href={`${base}/galerie`} class="link-underline">galerii</a>.
      </p>
    </header>

    <Gallery limit={6} showFilter={false} />

    <div class="featured-cta">
      <a href={`${base}/galerie`} class="btn btn-ghost">Celá galerie →</a>
    </div>
  </section>

  <section class="intro-section">
    <div class="intro-grid">
      <div>
        <span class="eyebrow">{site.location}</span>
        <h2 style="margin: 1rem 0 1.5rem;">{site.intro}</h2>
        <a href={`${base}/o-mne`} class="link-underline">Více o mně →</a>
      </div>
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .featured-section {
    padding: 8rem 0 4rem;
  }

  .section-header {
    max-width: var(--container);
    margin: 0 auto 4rem;
    padding: 0 var(--gutter);
  }

  .section-header h2 {
    margin: 1rem 0 1rem;
  }

  .section-header h2 em {
    font-style: italic;
    color: var(--ink-soft);
  }

  .section-header p {
    color: var(--ink-soft);
  }

  .featured-cta {
    text-align: center;
    padding: 4rem var(--gutter) 0;
  }

  .intro-section {
    padding: 8rem var(--gutter);
    border-top: 1px solid var(--line);
    margin-top: 6rem;
  }

  .intro-grid {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
  }

  .intro-grid > div {
    max-width: 36rem;
  }

  @media (max-width: 800px) {
    .intro-grid { grid-template-columns: 1fr; }
  }
</style>
