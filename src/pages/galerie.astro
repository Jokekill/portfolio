---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Gallery from '~/components/Gallery.astro';
import Lightbox from '~/components/Lightbox.astro';
---

<BaseLayout title="Galerie" description="Kompletní fotografické portfolio rozdělené podle kategorií.">
  <section class="page-header">
    <div class="page-header-inner">
      <span class="eyebrow">Portfolio</span>
      <h1>Galerie</h1>
      <p>
        Vyber kategorii nebo si projdi všechny fotografie. Po kliknutí na jakoukoli
        fotku se otevře větší náhled, mezi obrázky lze přecházet šipkami nebo
        gestem na mobilu.
      </p>
    </div>
  </section>

  <Gallery showFilter={true} />

  <Lightbox />
</BaseLayout>

<style>
  .page-header {
    padding: 10rem var(--gutter) 4rem;
  }

  .page-header-inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .page-header h1 {
    margin: 1rem 0 1.5rem;
    font-size: clamp(3rem, 8vw, 6rem);
  }

  .page-header p {
    max-width: 42ch;
  }
</style>
