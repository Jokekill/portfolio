---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { site } from '~/data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noFooterMargin?: boolean;
}

const {
  title,
  description = site.intro,
  ogImage = site.ogImage,
  noFooterMargin = false,
} = Astro.props;

const fullTitle = title
  ? `${title} — ${site.authorName}`
  : `${site.authorName} — ${site.tagline}`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.authorName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonty -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,300..700,30..100&family=Inter+Tight:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD strukturovaná data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.authorName,
      jobTitle: 'Fotograf',
      url: Astro.site?.toString(),
      sameAs: [site.instagramUrl],
      address: { '@type': 'PostalAddress', addressLocality: site.location },
    })} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer noMargin={noFooterMargin} />

    <script>
      // Header bg po scrollu
      const header = document.querySelector('.site-header');
      const onScroll = () => {
        if (window.scrollY > 40) header?.classList.add('scrolled');
        else header?.classList.remove('scrolled');
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
