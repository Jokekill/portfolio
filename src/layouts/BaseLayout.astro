---
import { ViewTransitions } from 'astro:transitions';
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import { site } from '~/data/site';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noFooterMargin?: boolean;
}

const {
  title,
  description = site.intro,
  ogImage = site.ogImage,
  noFooterMargin = false,
} = Astro.props;

const fullTitle = title
  ? `${title} — ${site.authorName}`
  : `${site.authorName} — ${site.tagline}`;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
---

<!DOCTYPE html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0908" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={site.authorName} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonty -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <!-- Gate pro reveal-on-scroll: skrývej jen když běží JS -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <ViewTransitions />

    <!-- JSON-LD strukturovaná data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: site.authorName,
      jobTitle: 'Fotograf',
      url: Astro.site?.toString(),
      sameAs: [site.instagramUrl],
      address: { '@type': 'PostalAddress', addressLocality: site.location },
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link">Přeskočit na obsah</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer noMargin={noFooterMargin} />
    <div class="grain" aria-hidden="true"></div>

    <script>
      // Header bg po scrollu — dotaz na element až v handleru,
      // aby fungoval i po view-transition výměně DOM
      const onScroll = () => {
        const header = document.querySelector('.site-header');
        header?.classList.toggle('scrolled', window.scrollY > 40);
      };
      window.addEventListener('scroll', onScroll, { passive: true });

      // Reveal-on-scroll pro [data-reveal] elementy
      const initPage = () => {
        onScroll();

        const els = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-visible)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
        );
        els.forEach((el) => io.observe(el));
      };

      // astro:page-load se spouští při prvním načtení i po každé navigaci
      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
